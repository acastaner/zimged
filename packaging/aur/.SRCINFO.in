pkgbase = zimged
	pkgdesc = A small, very fast image viewer and quick editor
	pkgver = @VERSION@
	pkgrel = 1
	url = https://github.com/acastaner/zimged
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = cmake
	makedepends = curl
	makedepends = meson
	makedepends = nasm
	makedepends = ninja
	depends = fontconfig
	depends = freetype2
	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	depends = libglvnd
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxrandr
	depends = wayland
	optdepends = xdg-desktop-portal: native open and save dialogs
	source = zimged-@VERSION@.tar.gz::https://github.com/acastaner/zimged/archive/refs/tags/v@VERSION@.tar.gz
	sha256sums = @SHA256@

pkgname = zimged
