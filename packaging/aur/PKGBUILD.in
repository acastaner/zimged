# Maintainer: Arnaud Castaner
# Generated by packaging/linux/build.sh from packaging/aur/PKGBUILD.in (#41); edit the template.
pkgname=zimged
pkgver=@VERSION@
pkgrel=1
pkgdesc='A small, very fast image viewer and quick editor'
arch=('x86_64' 'aarch64')
url='https://github.com/acastaner/zimged'
license=('GPL-3.0-or-later')
# winit and glutin dlopen the Wayland, X11 and GL libraries, so they are listed by hand.
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'libglvnd' 'libx11' 'libxcursor' 'libxi'
         'libxkbcommon' 'libxrandr' 'wayland')
# cmake, meson, ninja and nasm build libavif and dav1d (linked statically) for AVIF read.
makedepends=('cargo' 'cmake' 'meson' 'nasm' 'ninja')
optdepends=('xdg-desktop-portal: native open and save dialogs')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('@SHA256@')

prepare() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p zimged --features avif
}

# No check(): zimged's tests run in the local gate, which every release has passed (spec §9).

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 target/release/zimged "${pkgdir}/usr/bin/zimged"
  install -Dm644 packaging/linux/zimged.desktop "${pkgdir}/usr/share/applications/zimged.desktop"
  install -Dm644 packaging/linux/zimged.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/zimged.svg"
  install -Dm644 packaging/linux/io.github.acastaner.zimged.metainfo.xml \
    "${pkgdir}/usr/share/metainfo/io.github.acastaner.zimged.metainfo.xml"
}
