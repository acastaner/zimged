<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.acastaner.zimged</id>
  <name>zimged</name>
  <summary>View images fast and mark them up</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.acastaner">
    <name>Arnaud Castaner</name>
  </developer>
  <description>
    <p>
      zimged is a small, very fast image viewer and quick editor. You double-click an image and
      it is on screen almost at once. The mouse wheel or the arrow keys move through the other
      images in the same folder.
    </p>
    <p>
      You can mark an image up with shapes, text, numbered steps, highlights and blur, then save
      it or copy it to the clipboard.
    </p>
  </description>
  <launchable type="desktop-id">zimged.desktop</launchable>
  <url type="homepage">https://github.com/acastaner/zimged</url>
  <url type="bugtracker">https://github.com/acastaner/zimged/issues</url>
  <content_rating type="oars-1.1"/>
  <provides>
    <binary>zimged</binary>
    <mediatype>image/jpeg</mediatype>
    <mediatype>image/png</mediatype>
    <mediatype>image/webp</mediatype>
    <mediatype>image/gif</mediatype>
    <mediatype>image/bmp</mediatype>
    <mediatype>image/vnd.microsoft.icon</mediatype>
    <mediatype>image/tiff</mediatype>
    <mediatype>image/avif</mediatype>
  </provides>
  <releases>
    <release version="0.1.2" date="2026-11-01"/>
    <release version="0.1.1" date="2026-11-01"/>
    <release version="0.1.0" date="2026-10-29"/>
  </releases>
</component>
