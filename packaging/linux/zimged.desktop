[Desktop Entry]
Type=Application
Name=zimged
GenericName=Image Viewer
Comment=View images fast and mark them up
Exec=zimged %f
TryExec=zimged
Icon=zimged
Terminal=false
Categories=Graphics;Viewer;RasterGraphics;2DGraphics;
Keywords=image;picture;photo;viewer;annotate;markup;screenshot;
StartupNotify=true
StartupWMClass=zimged
# Every format zimged reads (spec §5.1): JPEG, PNG, WebP, GIF, BMP, ICO, TIFF, AVIF.
# This registers zimged as *a* handler only. No package ships a mimeapps.list or runs
# `xdg-mime default`: the user chooses the default (spec §8.5).
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/x-bmp;image/x-ms-bmp;image/vnd.microsoft.icon;image/x-icon;image/tiff;image/avif;
